{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viewly",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_BASE_URL": "https://api.scrapecreators.com"
  }
}
